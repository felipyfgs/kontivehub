APP_NAME='KontiveHub'
APP_ENV=production
APP_KEY='base64:SUBSTITUA_POR_32_BYTES_EM_BASE64'
APP_DEBUG=false
APP_URL='https://app.exemplo.com'
FRONTEND_URL='https://app.exemplo.com'
PORTAL_URL='https://portal.exemplo.com'

LOG_CHANNEL=stderr
FISCAL_PROFILE=production
FISCAL_KILL_SWITCH=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kontivehub
DB_USERNAME=kontivehub
DB_PASSWORD='SUBSTITUA_POR_UMA_SENHA_FORTE'

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD='SUBSTITUA_PELO_MESMO_VALOR_DO_SECRET_redis_password'
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID='SUBSTITUA'
REVERB_APP_KEY='SUBSTITUA'
REVERB_APP_SECRET='SUBSTITUA'
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_PORT=8081
REVERB_SCALING_ENABLED=true
REVERB_ALLOWED_ORIGINS='https://app.exemplo.com,https://portal.exemplo.com'

COMMUNICATION_ENABLED=false
COMMUNICATION_FLOWS_ENABLED=false
COMMUNICATION_FLOWS_RUNTIME_ENABLED=false
WAZYNC_ENABLED=false
WAZYNC_URL='http://wazync:8080'
WAZYNC_HMAC_KEY_ID='SUBSTITUA'
WAZYNC_HMAC_SECRET='SUBSTITUA_POR_NO_MINIMO_32_BYTES'

ASSISTANT_ENABLED=false
OPENAI_API_KEY=''
ASSISTANT_MODEL='gpt-4o-mini'

SESSION_COOKIE=kontivehub_session
SESSION_DOMAIN='.exemplo.com'
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS='app.exemplo.com,portal.exemplo.com'
CORS_ALLOWED_ORIGINS='https://app.exemplo.com,https://portal.exemplo.com'

VAULT_MASTER_KEY='SUBSTITUA_POR_32_BYTES_EM_BASE64'
VAULT_DISK_ROOT=/var/vault
