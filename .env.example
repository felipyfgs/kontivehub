# Copie para .env, proteja com chmod 600 e nunca versione o arquivo real.
# O mesmo arquivo .env é usado para dev ou produção; ajuste APP_ENV e flags conforme o alvo.
APP_ENV=local
DEVELOPMENT_DATA_PATH=/var/www/html/.local/dados
DEVELOPMENT_PLATFORM_ADMIN_EMAIL=platform@kontivehub.local
DEVELOPMENT_PLATFORM_ADMIN_PASSWORD=password
DEVELOPMENT_TENANT_ADMIN_EMAIL=admin@kontivehub.local
DEVELOPMENT_TENANT_ADMIN_PASSWORD=password
APP_DEBUG=true
APP_NAME="KontiveHub"
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000
COMPOSE_PROJECT_NAME=app
APP_PORT=8080
FRONTEND_DEV_PORT=3000
# IP ou hostname usado no browser remoto (HMR WebSocket do Nuxt dev)
# PUBLIC_HOST=192.168.0.10
CHOKIDAR_USEPOLLING=true

# Produção: obrigatório para HTTPS e cookies seguros.
ACME_EMAIL=infra@example.com
SESSION_DOMAIN=localhost
SESSION_COOKIE=kontivehub_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Compose injeta no PHP (vence apps/api/.env). Com PUBLIC_HOST, acrescente host:3000 e host:8080.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# PostgreSQL
DB_DATABASE=nfse
DB_USERNAME=nfse
DB_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Assistente de produto / OpenAI (fail-closed). Compose injeta no process env do PHP
# (vence apps/api/.env quando definido aqui). Após alterar: force-recreate php/horizon/scheduler/reverb.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini

# Atendimento WhatsApp nativo. Todos os gates ficam OFF até promoção explícita.
COMMUNICATION_ENABLED=false
# Engine/runtime de fluxos (fail-closed). Compose injeta no process env do PHP.
COMMUNICATION_FLOWS_ENABLED=false
COMMUNICATION_FLOWS_RUNTIME_ENABLED=false
# Iniciação outbound permanece bloqueada até rollout explícito por tenant.
COMMUNICATION_OUTBOUND_CONVERSATION_ENABLED=false
COMMUNICATION_OUTBOUND_CONVERSATION_KILL_SWITCH=true
COMMUNICATION_OUTBOUND_CONVERSATION_ALLOW_ALL_TENANTS=false
COMMUNICATION_OUTBOUND_CONVERSATION_ALLOWED_TENANT_IDS=
WAZYNC_ENABLED=false
BROADCAST_CONNECTION=log
WAZYNC_DB_USER=wazync
WAZYNC_DB_PASSWORD=
WAZYNC_DATABASE_URL=
WAZYNC_HMAC_KEY_ID=
WAZYNC_HMAC_SECRET=
WAZYNC_HMAC_PREVIOUS_KEY_ID=
WAZYNC_HMAC_PREVIOUS_SECRET=
# 32 bytes em base64; nunca versione o valor real.
WAZYNC_DATA_KEY=
WAZYNC_SESSION_CAPACITY=250
WAZYNC_LEASE_TTL=2m
WAZYNC_HEARTBEAT_EVERY=10s
WAZYNC_HMAC_WINDOW=5m
WAZYNC_NONCE_TTL=10m
COMMUNICATION_MEDIA_MAX_BYTES=20971520
COMMUNICATION_PROFILE_PICTURES_MAX_BYTES=2097152
COMMUNICATION_PROFILE_PICTURES_MAX_DIMENSION=4096
COMMUNICATION_PROFILE_PICTURES_CONNECT_TIMEOUT_SECONDS=5
COMMUNICATION_PROFILE_PICTURES_TIMEOUT_SECONDS=15
COMMUNICATION_PROFILE_PICTURES_GATEWAY_TIMEOUT_SECONDS=90
COMMUNICATION_PROFILE_PICTURES_NEGATIVE_TTL_SECONDS=86400
COMMUNICATION_PROFILE_PICTURES_REFRESH_TTL_SECONDS=86400
COMMUNICATION_PROFILE_PICTURES_BATCH_SIZE=100
COMMUNICATION_PROFILE_PICTURES_INBOX_BATCH_SIZE=25
COMMUNICATION_PROFILE_PICTURES_STREAM_RATE_LIMIT_PER_MINUTE=600
COMMUNICATION_PROFILE_PICTURES_STREAM_IP_RATE_LIMIT_PER_MINUTE=1200
COMMUNICATION_HISTORY_MEDIA_RECOVERY_ENABLED=false
COMMUNICATION_HISTORY_MEDIA_RECOVERY_KILL_SWITCH=true
COMMUNICATION_HISTORY_MEDIA_RECOVERY_MAX_BATCH=25
COMMUNICATION_HISTORY_MEDIA_RECOVERY_SESSION_LIMIT=25
COMMUNICATION_HISTORY_MEDIA_RECOVERY_BACKOFF_SECONDS=300
COMMUNICATION_HISTORY_MEDIA_RECOVERY_ACCEPTED_RESULT_TIMEOUT_SECONDS=900

# Reverb usa credenciais reais somente quando Comunicação for promovida.
REVERB_APP_ID=communication-disabled
REVERB_APP_KEY=communication-disabled
REVERB_APP_SECRET=communication-disabled
REVERB_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Backend/prod secrets (também em apps/api/.env no dev — ver apps/api/.env.example)
APP_KEY=
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_VERSION=1
VAULT_PREVIOUS_MASTER_KEYS=
# BACKUP_DISK_ROOT=/var/backups/nfse
# BACKUP_RETENTION_RUNS=7
# BACKUP_SCHEDULE_ENABLED=false

# E-mail e logs
LOG_CHANNEL=stderr
LOG_LEVEL=debug
MAIL_MAILER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=substitua-pelo-usuario-smtp
MAIL_PASSWORD=substitua-pela-senha-smtp
MAIL_FROM_ADDRESS=noreply@kontivehub.com.br
MAIL_FROM_NAME="KontiveHub"

# Onboarding inicial — desligar após o primeiro PLATFORM_ADMIN.
INITIAL_ONBOARDING_ENABLED=false
INITIAL_ONBOARDING_TOKEN=

# Perfil único do núcleo fiscal: dev | trial | production.
# Compose injeta FISCAL_PROFILE nos containers PHP (sobrescreve apps/api/.env se omitido aqui).
# production = drivers reais + bilhetagem SERPRO — só para avaliação local deliberada.
FISCAL_PROFILE=dev
FISCAL_KILL_SWITCH=false
PLATFORM_PRIVILEGED_CONTEXT=false

# SERPRO / Integra Contador — defaults fail-closed. Nunca coloque Consumer Secret/PFX aqui.
SERPRO_DEFAULT_ENVIRONMENT=TRIAL
SERPRO_USE_FAKE_CLIENTS=false
SERPRO_KILL_SWITCH=true

# Pagamento PGDAS-D via PAGTOWEB (PAGAMENTOS71). OFF por default; só liga em PRODUÇÃO deliberada.
# PGDASD_PAGTOWEB_RECONCILIATION_ENABLED=false

# Automacao interna dos portais MEI
MEI_AUTOMATION_ENABLED=false
MEI_AUTOMATION_LIVE_EGRESS_ENABLED=false
MEI_AUTOMATION_FIXTURE_ENABLED=false
MEI_AUTOMATION_HMAC_KEY_ID=laravel
MEI_AUTOMATION_HMAC_SECRET=
MEI_AUTOMATION_POLL_INTERVAL=10
MEI_AUTOMATION_RESULT_TTL_SECONDS=900
MEI_AUTOMATION_ARTIFACT_MAX_BYTES=10485760
MEI_AUTOMATION_ARTIFACT_TTL_SECONDS=300
MEI_AUTOMATION_REDIS_URL=redis://redis:6379/4
MEI_AUTOMATION_PROVIDER_DEFAULT=serpro
MEI_AUTOMATION_PROVIDER_PGMEI_DAS_PDF=serpro
MEI_AUTOMATION_PROVIDER_PGMEI_DAS_BARCODE=serpro
MEI_AUTOMATION_PROVIDER_PGMEI_DEBT=serpro
MEI_AUTOMATION_PROVIDER_DASN_HISTORY=serpro
MEI_AUTOMATION_CAPTCHA_DRIVER=manual
MEI_AUTOMATION_CAPTCHA_BUDGET_MICROS=0
MEI_AUTOMATION_NOPECHA_ENABLED=false
MEI_AUTOMATION_NOPECHA_API_KEY=
MEI_AUTOMATION_NOPECHA_OPERATION_ALLOWLIST=
MEI_AUTOMATION_NOPECHA_UNIT_COST_MICROS=0
MEI_AUTOMATION_NOPECHA_TIMEOUT_SECONDS=180
MEI_AUTOMATION_NOPECHA_POLL_INTERVAL_SECONDS=1
# Opcional: http://user:pass@host:port (IP do proxy deve ser o do submit)
MEI_AUTOMATION_NOPECHA_PROXY_URL=
MEI_AUTOMATION_BROWSER_HEADLESS=false
MEI_AUTOMATION_BROWSER_CHANNEL=chrome

# FGTS Digital / Gov.br — solver externo OFF por padrão.
# Ao usar nopecha, o mesmo proxy autenticado deve servir browser e provider.
FGTS_DIGITAL_CAPTCHA_DRIVER=disabled
FGTS_DIGITAL_NOPECHA_API_KEY=
FGTS_DIGITAL_PROXY_URL=
FGTS_DIGITAL_CAPTCHA_TIMEOUT_SECONDS=180
FGTS_DIGITAL_CAPTCHA_POLL_INTERVAL_MILLISECONDS=1000
FGTS_DIGITAL_CAPTCHA_MAX_ATTEMPTS=1
FGTS_DIGITAL_CAPTCHA_MAX_CREDITS_PER_RUN=5

# eSocial BX oficial — read-only e fail-closed.
FGTS_ESOCIAL_DRIVER=disabled
FGTS_ESOCIAL_ENVIRONMENT=restricted
FGTS_ESOCIAL_PRODUCTION_EGRESS_ENABLED=false
FGTS_ESOCIAL_KILL_SWITCH=false
FGTS_ESOCIAL_DAILY_ACCESS_LIMIT=10
FGTS_ESOCIAL_TIMEZONE=America/Sao_Paulo
FGTS_ESOCIAL_MINIMUM_LAG_MINUTES=60
FGTS_ESOCIAL_MAX_QUERY_INTERVAL_DAYS=31
FGTS_ESOCIAL_LOCK_SECONDS=180
FGTS_ESOCIAL_CONNECT_TIMEOUT_SECONDS=15
FGTS_ESOCIAL_TIMEOUT_SECONDS=90
SERPRO_USAGE_SHADOW_MODE=true
SERPRO_USAGE_COMMERCIAL_BLOCKING=false
SERPRO_SMOKE_ENABLED=false
SERPRO_PROD_CHECK_STRICT=false
SERPRO_RETENTION_PFX_DAYS=2555
SERPRO_RETENTION_TOKEN_DAYS=0
SERPRO_RETENTION_TERMO_DAYS=2555
SERPRO_RETENTION_LEDGER_DAYS=2555

# SEFAZ / autXML — OFF por padrão
SEFAZ_DISTDFE_ENABLED=false
SEFAZ_MANIFEST_ENABLED=false
SEFAZ_CTE_ENABLED=false
SEFAZ_CTE_EMITTER_PUSH_ENABLED=false
SEFAZ_CTE_EMITTER_PUSH_RATE_LIMIT=30
SEFAZ_CTE_EMITTER_PUSH_IP_RATE_LIMIT=30
# Opcional; em produção prefira chave estável dedicada. Vazio usa APP_KEY.
SEFAZ_CTE_EMITTER_PUSH_RATE_LIMIT_KEY=
SEFAZ_CTE_EMITTER_PUSH_ADMIN_TOKEN_RATE_LIMIT=10
SEFAZ_NFCE_ENABLED=false
SEFAZ_MA_OUTBOUND_ENABLED=false
SEFAZ_AUTXML_DISTDFE_ENABLED=false
SEFAZ_CTE_AUTXML_DISTDFE_ENABLED=false
SEFAZ_SVRS_NFCE_XML_RETRIEVAL_ENABLED=false
SEFAZ_SVRS_NFE55_XML_RETRIEVAL_ENABLED=false

OPS_SCHEDULER_HEARTBEAT_MAX_AGE=180
