# Fonte única de configuração dos manifestos Docker. Copie para .env, use
# chmod 600 e nunca versione valores reais. Produção deve substituir todos os
# exemplos e preencher os campos obrigatórios vazios.

# Projeto e imagens
COMPOSE_PROJECT_NAME=kontivehub
KONTIVEHUB_REGISTRY=ghcr.io/felipyfgs/kontivehub
KONTIVEHUB_VERSION=sha-example

# Aplicação
APP_NAME=KontiveHub
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
PORTAL_URL=http://localhost:3000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_DEV_PORT=3000
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Identidade do host para volumes de desenvolvimento
LOCAL_UID=1000
LOCAL_GID=1000
PUBLIC_HOST=127.0.0.1
CHOKIDAR_USEPOLLING=true
NUXT_DEVTOOLS=true
PNPM_CONFIG_STORE_DIR=

# Banco e cache. Vazios usam defaults exclusivamente locais; produção falha
# antes do deploy enquanto DB_PASSWORD e REDIS_PASSWORD estiverem vazios.
DB_DATABASE=kontivehub
DB_USERNAME=kontivehub
DB_PASSWORD=
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379

# Sessão e origens
SESSION_ENCRYPT=true
SESSION_COOKIE=kontivehub_session
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:3000,${PUBLIC_HOST}:${APP_PORT},${PUBLIC_HOST}:${FRONTEND_DEV_PORT}
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://${PUBLIC_HOST}:${APP_PORT},http://${PUBLIC_HOST}:${FRONTEND_DEV_PORT}

# Perfil fiscal fail-closed
FISCAL_PROFILE=dev
FISCAL_KILL_SWITCH=false

# Dados de desenvolvimento; nunca reutilize estas credenciais em produção.
DEVELOPMENT_PLATFORM_ADMIN_EMAIL=platform@example.com
DEVELOPMENT_PLATFORM_ADMIN_PASSWORD=password
DEVELOPMENT_TENANT_ADMIN_EMAIL=admin@example.com
DEVELOPMENT_TENANT_ADMIN_PASSWORD=password

# Assistente
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini

# Comunicação e realtime
COMMUNICATION_ENABLED=false
COMMUNICATION_FLOWS_ENABLED=false
COMMUNICATION_FLOWS_RUNTIME_ENABLED=false
COMMUNICATION_OUTBOUND_CONVERSATION_ENABLED=false
COMMUNICATION_OUTBOUND_CONVERSATION_KILL_SWITCH=true
COMMUNICATION_MEDIA_MAX_BYTES=20971520
COMMUNICATION_OUTBOUND_CONTACTS_ARRAY_ENABLED=false
COMMUNICATION_OUTBOUND_GIF_ENABLED=false
COMMUNICATION_OUTBOUND_PTV_ENABLED=false
COMMUNICATION_OUTBOUND_EVENT_ENABLED=false
COMMUNICATION_OUTBOUND_VIEW_ONCE_ENABLED=false
COMMUNICATION_OUTBOUND_MEDIA_BATCH_ENABLED=false
COMMUNICATION_GIF_PROVIDER=disabled
COMMUNICATION_GIF_PROVIDER_URL=
COMMUNICATION_GIF_PROVIDER_API_KEY=
COMMUNICATION_GIF_PROVIDER_ALLOWED_HOSTS=
BROADCAST_CONNECTION=log
REVERB_APP_ID=communication-disabled
REVERB_APP_KEY=communication-disabled
REVERB_APP_SECRET=communication-disabled
REVERB_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://${PUBLIC_HOST}:${APP_PORT},http://${PUBLIC_HOST}:${FRONTEND_DEV_PORT}

# Wazync
WAZYNC_ENABLED=false
WAZYNC_DB_USER=wazync
WAZYNC_DB_PASSWORD=
WAZYNC_DATABASE_URL=
WAZYNC_HMAC_KEY_ID=
WAZYNC_HMAC_SECRET=
WAZYNC_HMAC_PREVIOUS_KEY_ID=
WAZYNC_HMAC_PREVIOUS_SECRET=
WAZYNC_DATA_KEY=
WAZYNC_SESSION_CAPACITY=250
WAZYNC_LEASE_TTL=2m
WAZYNC_HEARTBEAT_EVERY=10s
WAZYNC_HMAC_WINDOW=5m
WAZYNC_NONCE_TTL=10m
WAZYNC_WHATSAPP_CONNECT_TIMEOUT=20s
WAZYNC_WHATSAPP_READY_TIMEOUT=30s
WAZYNC_WHATSAPP_HTTP_TIMEOUT=45s
WAZYNC_WHATSAPP_PROXY_URL=
WAZYNC_WHATSAPP_RETRY_HANDLERS=4

# Persistência criptografada
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_VERSION=1

# Proxy externo. Produção exige 64 caracteres hexadecimais e rejeita zeros.
NGINX_EDGE_TOKEN=
