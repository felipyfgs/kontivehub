# Exclusivo para desenvolvimento local. Copie para .env, use chmod 600 e nunca
# versione o arquivo real. Produção usa os Docker Secrets descritos em
# infra/swarm/README.md; este arquivo nunca alimenta docker-stack.yml.

# Docker Compose
COMPOSE_PROJECT_NAME=app
APP_ENV=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_DEV_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Ajuste para os valores de `id -u` e `id -g` quando não forem 1000.
LOCAL_UID=1000
LOCAL_GID=1000

# IP/hostname anunciado ao browser. Para acesso remoto, troque PUBLIC_HOST e
# defina APP_BIND_ADDRESS e FRONTEND_BIND_ADDRESS com endereços alcançáveis.
PUBLIC_HOST=127.0.0.1
CHOKIDAR_USEPOLLING=true
NUXT_DEVTOOLS=true
# Vazio usa o store padrão do pnpm dentro do container.
PNPM_CONFIG_STORE_DIR=

# PostgreSQL
DB_DATABASE=nfse
DB_USERNAME=nfse
DB_PASSWORD=change-me

# API e sessão
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000,${PUBLIC_HOST}:8080,${PUBLIC_HOST}:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://${PUBLIC_HOST}:8080,http://${PUBLIC_HOST}:3000

# Perfil fiscal fail-closed
FISCAL_PROFILE=dev
FISCAL_KILL_SWITCH=false

# Assistente de produto / OpenAI
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini

# Comunicação e realtime
COMMUNICATION_ENABLED=false
COMMUNICATION_FLOWS_ENABLED=false
COMMUNICATION_FLOWS_RUNTIME_ENABLED=false
COMMUNICATION_MEDIA_MAX_BYTES=20971520
BROADCAST_CONNECTION=log
REVERB_APP_ID=communication-disabled
REVERB_APP_KEY=communication-disabled
REVERB_APP_SECRET=communication-disabled
REVERB_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://${PUBLIC_HOST}:8080,http://${PUBLIC_HOST}:3000

# Wazync
WAZYNC_ENABLED=false
WAZYNC_DB_USER=wazync
WAZYNC_DB_PASSWORD=
WAZYNC_DATABASE_URL=
WAZYNC_HMAC_KEY_ID=
WAZYNC_HMAC_SECRET=
WAZYNC_HMAC_PREVIOUS_KEY_ID=
WAZYNC_HMAC_PREVIOUS_SECRET=
# 32 bytes em base64; nunca versione o valor real.
WAZYNC_DATA_KEY=
WAZYNC_SESSION_CAPACITY=250
WAZYNC_LEASE_TTL=2m
WAZYNC_HEARTBEAT_EVERY=10s
WAZYNC_HMAC_WINDOW=5m
WAZYNC_NONCE_TTL=10m
WAZYNC_WHATSAPP_CONNECT_TIMEOUT=20s
WAZYNC_WHATSAPP_READY_TIMEOUT=30s
WAZYNC_WHATSAPP_HTTP_TIMEOUT=45s
WAZYNC_WHATSAPP_PROXY_URL=
WAZYNC_WHATSAPP_RETRY_HANDLERS=4
