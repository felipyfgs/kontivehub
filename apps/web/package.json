{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "types:api": "node scripts/generate-public-api-types.mjs",
    "types:api:check": "node scripts/check-generated-api-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gate": "pnpm run types:api:check && pnpm run lint && pnpm run typecheck && pnpm run generate && pnpm run test && pnpm run test:fidelity && pnpm run test:artifacts",
    "test:artifacts": "node tests/security/scan-artifacts.mjs",
    "test:fidelity": "node scripts/template-fidelity-gate.mjs",
    "cleanup:browsers": "node scripts/cleanup-dev-browsers.mjs",
    "test:e2e": "node tests/e2e/run-local.mjs",
    "test:e2e:direct": "playwright test",
    "pw:cli": "playwright-cli --config .playwright/cli.config.json",
    "pw:open": "playwright-cli --config .playwright/cli.config.json open http://127.0.0.1:3000 --headed",
    "pw:snapshot": "playwright-cli --config .playwright/cli.config.json snapshot",
    "pw:screenshot": "playwright-cli --config .playwright/cli.config.json screenshot"
  },

  "dependencies": {
    "@iconify-json/lucide": "^1.2.116",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.9.0",
    "@tanstack/table-core": "^8.21.3",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vue-dnd-kit/core": "^2.4.7",
    "@vue-dnd-kit/nuxt": "^1.0.2",
    "@vue-flow/core": "1.48.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "date-fns": "^4.4.0",
    "laravel-echo": "^2.4.0",
    "nuxt": "^4.4.8",
    "nuxt-auth-sanctum": "^3.1.0",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@11.9.0"
}
