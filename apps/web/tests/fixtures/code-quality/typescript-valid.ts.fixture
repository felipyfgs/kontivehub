import type { Ref } from 'vue'

export interface RunnerContract {
  run(value?: string): Promise<string>
}

export class Runner implements RunnerContract {
  constructor(private readonly active: Ref<boolean>) {}

  async run(value = ''): Promise<string> {
    if (!this.active.value) return ''
    return value.trim()
  }
}

export function createRunner(active: Ref<boolean>): Runner {
  return new Runner(active)
}
