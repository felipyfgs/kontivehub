<template>
  <UButton @click="submit(false)">
    Salvar
  </UButton>
</template>

<script setup lang="ts">
import type { ButtonProps } from '@nuxt/ui'

const props = defineProps<{ disabled?: boolean }>()
const emit = defineEmits<{ saved: [force: boolean] }>()

const submit = async (force = false) => {
  if (!props.disabled || force) emit('saved', force)
}

const tone: ButtonProps['color'] = 'primary'
</script>
