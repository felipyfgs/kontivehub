{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiscal-hub.local/schemas/code-quality-audit.v1.json",
  "title": "KontiveHub code-quality audit artifacts",
  "type": "object",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(apps/(api|web)|docs)/",
      "not": {
        "pattern": "(^|/)(vendor|node_modules|\\.nuxt|\\.output)(/|$)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "language": {
      "type": "string",
      "enum": [
        "php",
        "typescript",
        "javascript",
        "vue",
        "python",
        "json",
        "yaml",
        "xml",
        "xsd",
        "css",
        "markdown",
        "text",
        "image",
        "shell",
        "other"
      ]
    },
    "fileCategory": {
      "type": "string",
      "enum": [
        "application",
        "bootstrap",
        "configuration",
        "route",
        "migration",
        "factory",
        "seeder",
        "resource",
        "rpa",
        "server",
        "script",
        "test",
        "fixture",
        "public-asset",
        "dependency-manifest",
        "control",
        "storage-placeholder",
        "documentation",
        "other"
      ]
    },
    "parseError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "message"],
      "properties": {
        "language": {
          "$ref": "#/$defs/language"
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "message": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "app",
        "category",
        "language",
        "bytes",
        "lines",
        "sha256",
        "executable",
        "symbolCount",
        "parseErrors"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "app": {
          "type": "string",
          "enum": ["api", "web"]
        },
        "category": {
          "$ref": "#/$defs/fileCategory"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable": {
          "type": "boolean"
        },
        "symbolCount": {
          "type": "integer",
          "minimum": 0
        },
        "parseErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parseError"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "optional", "variadic", "byReference"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "type": ["string", "null"]
        },
        "optional": {
          "type": "boolean"
        },
        "variadic": {
          "type": "boolean"
        },
        "byReference": {
          "type": "boolean"
        }
      }
    },
    "symbolMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "branches",
        "complexity",
        "maxDepth",
        "parameterCount",
        "importFanOut",
        "tokenCount"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 1
        },
        "branches": {
          "type": "integer",
          "minimum": 0
        },
        "complexity": {
          "type": "integer",
          "minimum": 1
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "parameterCount": {
          "type": "integer",
          "minimum": 0
        },
        "importFanOut": {
          "type": "integer",
          "minimum": 0
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "symbolKind": {
      "type": "string",
      "enum": [
        "class",
        "interface",
        "trait",
        "enum",
        "method",
        "function",
        "closure",
        "arrow-function"
      ]
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "qualifiedName",
        "displayName",
        "kind",
        "language",
        "startLine",
        "endLine",
        "parameters",
        "metrics",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "qualifiedName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "parentId": {
          "type": ["string", "null"]
        },
        "kind": {
          "$ref": "#/$defs/symbolKind"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "metrics": {
          "$ref": "#/$defs/symbolMetrics"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "roots", "excludedByGitIgnore"],
      "properties": {
        "command": {
          "const": "git ls-files --cached --others --exclude-standard apps/api apps/web"
        },
        "roots": {
          "type": "array",
          "const": ["apps/api", "apps/web"]
        },
        "excludedByGitIgnore": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "inventorySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "symbols",
        "executableFiles",
        "parseErrors",
        "byApp",
        "byCategory",
        "byLanguage",
        "bySymbolKind"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "symbols": {
          "type": "integer",
          "minimum": 0
        },
        "executableFiles": {
          "type": "integer",
          "minimum": 0
        },
        "parseErrors": {
          "type": "integer",
          "minimum": 0
        },
        "byApp": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byCategory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byLanguage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bySymbolKind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "scope", "digest", "summary", "files", "symbols"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "$ref": "#/$defs/inventorySummary"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbol"
          }
        }
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed-no-finding",
        "reviewed-with-findings",
        "excluded-with-reason"
      ]
    },
    "reviewCategory": {
      "type": "string",
      "enum": [
        "functional-correctness",
        "security-tenancy",
        "authorization-validation",
        "data-integrity-transactions",
        "error-handling-observability",
        "performance-concurrency",
        "duplication-responsibility",
        "ambiguity-naming",
        "dead-code-consumers",
        "typing-contracts",
        "testability-coverage",
        "ux-accessibility"
      ]
    },
    "reviewEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolId", "status", "categories", "findingIds", "note"],
      "properties": {
        "symbolId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reviewCategory"
          }
        },
        "findingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CQ-[0-9]{4}$"
          }
        },
        "note": {
          "type": "string"
        },
        "reviewBatch": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed-with-findings"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "categories": {
                "minItems": 1
              },
              "findingIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed-no-finding"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "categories": {
                "minItems": 1
              },
              "findingIds": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "excluded-with-reason"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "note": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "inventoryDigest", "entries"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "inventoryDigest": {
          "$ref": "#/$defs/sha256"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewEntry"
          }
        }
      }
    },
    "findingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "description"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "symbolId": {
          "type": ["string", "null"]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "uiEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype",
        "templatePath",
        "productPath",
        "shells",
        "states",
        "viewports",
        "colorModes"
      ],
      "properties": {
        "archetype": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "templatePath": {
          "type": "string",
          "pattern": "^\\.local/reference/nuxt-dashboard-template/"
        },
        "productPath": {
          "type": "string",
          "pattern": "^apps/web/"
        },
        "shells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "viewports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "colorModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["light", "dark"]
          }
        }
      }
    },
    "findingCategory": {
      "type": "string",
      "enum": [
        "functional-defect",
        "security-tenancy",
        "authorization-validation",
        "data-integrity",
        "error-handling",
        "performance-concurrency",
        "duplication",
        "ambiguous-contract",
        "dead-code",
        "typing",
        "testability",
        "ux-accessibility",
        "structural-debt"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "title",
        "evidence",
        "impact",
        "recommendation",
        "expectedTests",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CQ-[0-9]{4}$"
        },
        "severity": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "category": {
          "$ref": "#/$defs/findingCategory"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/findingEvidence"
          }
        },
        "impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "recommendation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expectedTests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "planned",
            "in-progress",
            "resolved",
            "accepted-risk",
            "blocked",
            "false-positive"
          ]
        },
        "change": {
          "type": ["string", "null"]
        },
        "resolution": {
          "type": ["string", "null"]
        },
        "ui": {
          "oneOf": [
            {
              "$ref": "#/$defs/uiEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "ux-accessibility"
              }
            },
            "required": ["category"]
          },
          "then": {
            "required": ["ui"],
            "properties": {
              "ui": {
                "$ref": "#/$defs/uiEvidence"
              }
            }
          }
        }
      ]
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "inventoryDigest", "items"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "inventoryDigest": {
          "$ref": "#/$defs/sha256"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "summaryMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "combinedDigest", "inventoryDigests", "api", "web"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "combinedDigest": {
          "$ref": "#/$defs/sha256"
        },
        "inventoryDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "web"],
          "properties": {
            "api": {
              "$ref": "#/$defs/sha256"
            },
            "web": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "api": {
          "$ref": "#/$defs/inventorySummary"
        },
        "web": {
          "$ref": "#/$defs/inventorySummary"
        }
      }
    }
  }
}
