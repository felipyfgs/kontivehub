import asyncio


class Example:
    async def execute(self, items: list[str], limit: int = 2) -> list[str]:
        normalize = lambda value: value.strip().lower()

        async def settle(value: str) -> str:
            await asyncio.sleep(0)
            return normalize(value)

        return [await settle(item) for item in items[:limit]]


def standalone(value: str, *, enabled: bool = True) -> str:
    if enabled and value:
        return value.strip()
    return ""
