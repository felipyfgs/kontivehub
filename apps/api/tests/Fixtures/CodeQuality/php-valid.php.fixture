<?php

namespace Fixtures\CodeQuality;

#[\Attribute]
class Marker
{
}

function standalone(string $value, int $limit = 2): array
{
    return array_map(
        static fn (string $item): string => trim($item),
        array_slice(explode(',', $value), 0, $limit),
    );
}

class Example
{
    public function execute(array $items): array
    {
        $normalize = static function (string $item): string {
            return strtolower(trim($item));
        };

        return array_map($normalize, $items);
    }
}
